@model IEnumerable<Domin.Entity.Request>
@inject UserManager<ApplicationUser> userManager
@inject SignInManager<ApplicationUser> signInManager
@using Infarstuructre.ViewModel;  // Replace with your actual namespace

@{
    ViewData["Title"] = "قائمة الطلبات";

}
<style>
    .top{
        margin-top:200px;
    }
</style>
@if (signInManager.IsSignedIn(User))
{

<div class="content-wrapper top">
    <h1>@ViewData["Title"]</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>رقم الطلب</th>
                <th>العميل</th>
                <th>المزود</th>
                <th>الخدمة</th>
                <th>التاريخ</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RequestId</td>
                    <td>@item.Customer.Username</td>
                    <td>@item.Provider.ProviderName</td>
                    <td>@item.Service.Name</td>
                    <td>@item.OrderDate.ToString("yyyy/MM/dd")</td>
                    <td>
                        @if (item.Status)
                        {
                            <span class="badge bg-success">مكتمل</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">قيد الانتظار</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.RequestId" class="btn btn-sm btn-primary">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@item.RequestId" class="btn btn-sm btn-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4">
        <a asp-action="Create" class="btn btn-success">إضافة طلب جديد</a>
    </div>
</div>}